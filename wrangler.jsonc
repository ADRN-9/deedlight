{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deedlight",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "deedlight"
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true
}
