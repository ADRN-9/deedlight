new file mode 100644
index 0000000..efad7f3
--- /dev/null
+++ b/app/api/webhooks/resend/route.ts
@@ -0,0 +1,112 @@
+import { createClient } from "@supabase/supabase-js";
+import {
+  InvalidResendWebhook,
+  verifyResendDeliveryWebhook,
+} from "@/lib/delivery/resend-webhook";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const MAX_WEBHOOK_BYTES = 128 * 1024;
+
+async function readLimitedRawBody(request: Request): Promise<string> {
+  if (!request.body) throw new InvalidResendWebhook("Missing webhook body");
+  const reader = request.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let bytes = 0;
+  try {
+    while (true) {
+      const { value, done } = await reader.read();
+      if (done) break;
+      bytes += value.byteLength;
+      if (bytes > MAX_WEBHOOK_BYTES) {
+        await reader.cancel();
+        throw new InvalidResendWebhook("Webhook payload exceeds size limit");
+      }
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  const raw = new Uint8Array(bytes);
+  let offset = 0;
+  for (const chunk of chunks) {
+    raw.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  try {
+    return new TextDecoder("utf-8", { fatal: true }).decode(raw);
+  } catch {
+    throw new InvalidResendWebhook("Webhook payload is not valid UTF-8");
+  }
+}
+
+function isValidSupabaseUrl(value: string): boolean {
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:"
+      && /^[a-z0-9-]+\.supabase\.co$/.test(url.hostname)
+      && !url.username && !url.password && !url.port
+      && (url.pathname === "/" || url.pathname === "")
+      && !url.search && !url.hash;
+  } catch {
+    return false;
+  }
+}
+
+const responseHeaders = {
+  "Cache-Control": "no-store",
+  "Content-Type": "text/plain; charset=utf-8",
+};
+
+export async function POST(request: Request): Promise<Response> {
+  const secret = process.env.RESEND_WEBHOOK_SECRET;
+  const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY;
+  const supabaseUrl = process.env.SUPABASE_URL;
+  if (!secret || !serviceRoleKey || !supabaseUrl || !isValidSupabaseUrl(supabaseUrl)) {
+    return new Response("Webhook unavailable", { status: 503, headers: responseHeaders });
+  }
+  const declaredLength = Number(request.headers.get("content-length") || "0");
+  if (!Number.isSafeInteger(declaredLength) || declaredLength > 128 * 1024) {
+    return new Response("Payload too large", { status: 413, headers: responseHeaders });
+  }
+  if (!request.headers.get("content-type")?.toLowerCase().startsWith("application/json")) {
+    return new Response("Unsupported media type", { status: 415, headers: responseHeaders });
+  }
+
+  let event;
+  try {
+    event = await verifyResendDeliveryWebhook({
+      rawBody: await readLimitedRawBody(request),
+      headers: request.headers,
+      secret,
+    });
+  } catch (error) {
+    if (error instanceof InvalidResendWebhook) {
+      return new Response("Invalid webhook", { status: 400, headers: responseHeaders });
+    }
+    return new Response("Webhook unavailable", { status: 503, headers: responseHeaders });
+  }
+
+  try {
+    const client = createClient(supabaseUrl, serviceRoleKey, {
+      auth: { autoRefreshToken: false, detectSessionInUrl: false, persistSession: false },
+    });
+    const { data, error } = await client.rpc("deedlight_record_resend_verified", {
+      p_event_id: event.eventId,
+      p_provider_email_id: event.providerEmailId,
+      p_recipient_email: event.recipientEmail,
+      p_event_type: event.eventType,
+      p_event_at: event.eventAt,
+      p_payload_sha256: event.payloadSha256,
+      p_suppression_reason: event.suppressionReason,
+    });
+    if (error || !["recorded", "pending", "duplicate", "quarantined"].includes(data)) {
+      return new Response("Webhook temporarily unavailable", { status: 503, headers: responseHeaders });
+    }
+    // Acknowledged only after durable DB COMMIT, including pending/quarantine.
+    return new Response("Accepted", { status: data === "pending" ? 202 : 200, headers: responseHeaders });
+  } catch {
+    return new Response("Webhook temporarily unavailable", { status: 503, headers: responseHeaders });
+  }
+}
diff --git a/lib/delivery/resend-webhook.ts b/lib/delivery/resend-webhook.ts
new file mode 100644
index 0000000..c447aa9
--- /dev/null
+++ b/lib/delivery/resend-webhook.ts
@@ -0,0 +1,133 @@
+import { Webhook } from "svix";
+
+export type VerifiedResendDeliveryEvent = {
+  eventId: string;
+  providerEmailId: string;
+  recipientEmail: string;
+  eventType: string;
+  eventAt: string;
+  payloadSha256: string;
+  suppressionReason: "permanent_bounce" | "spam_complaint" | null;
+};
+
+const EVENT_TYPES = new Set([
+  "email.sent", "email.delivered", "email.delivery_delayed", "email.failed",
+  "email.bounced", "email.complained", "email.suppressed",
+]);
+const MAX_WEBHOOK_BYTES = 128 * 1024;
+const MAX_TIMESTAMP_SKEW_SECONDS = 300;
+
+export class InvalidResendWebhook extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "InvalidResendWebhook";
+  }
+}
+
+function requiredHeader(headers: Headers, name: string): string {
+  const value = headers.get(name);
+  if (!value || value.length > 512 || /[\r\n]/.test(value)) {
+    throw new InvalidResendWebhook("Missing or invalid signature metadata");
+  }
+  return value;
+}
+
+export async function verifyResendDeliveryWebhook(input: {
+  rawBody: string;
+  headers: Headers;
+  secret: string;
+  now?: Date;
+}): Promise<VerifiedResendDeliveryEvent> {
+  const { rawBody, headers, secret, now = new Date() } = input;
+  if (!/^whsec_[A-Za-z0-9+/=_-]{20,}$/.test(secret)) {
+    throw new Error("Resend webhook signing secret is unavailable");
+  }
+  if (new TextEncoder().encode(rawBody).byteLength > MAX_WEBHOOK_BYTES) {
+    throw new InvalidResendWebhook("Webhook payload is too large");
+  }
+  const eventId = requiredHeader(headers, "svix-id");
+  const timestamp = requiredHeader(headers, "svix-timestamp");
+  const signature = requiredHeader(headers, "svix-signature");
+  if (!/^msg_[A-Za-z0-9_-]{6,180}$/.test(eventId)
+    || !/^[0-9]{10,12}$/.test(timestamp)) {
+    throw new InvalidResendWebhook("Invalid signed event identity");
+  }
+  const signedAt = Number(timestamp);
+  if (!Number.isSafeInteger(signedAt)
+    || !Number.isFinite(now.getTime())
+    || Math.abs(now.getTime() / 1000 - signedAt) > MAX_TIMESTAMP_SKEW_SECONDS) {
+    throw new InvalidResendWebhook("Webhook signature timestamp outside allowed window");
+  }
+
+  let envelope: unknown;
+  try {
+    new Webhook(secret).verify(rawBody, {
+      "svix-id": eventId,
+      "svix-timestamp": timestamp,
+      "svix-signature": signature,
+    });
+    // The SDK verifies bytes; decode exactly those authenticated bytes.
+    envelope = JSON.parse(rawBody);
+  } catch {
+    throw new InvalidResendWebhook("Webhook signature verification failed");
+  }
+  if (!envelope || typeof envelope !== "object" || Array.isArray(envelope)) {
+    throw new InvalidResendWebhook("Invalid verified event envelope");
+  }
+  const obj = envelope as Record<string, unknown>;
+  const type = obj.type;
+  const data = obj.data;
+  if (typeof type !== "string" || !EVENT_TYPES.has(type)
+    || !data || typeof data !== "object" || Array.isArray(data)) {
+    throw new InvalidResendWebhook("Unsupported verified provider event");
+  }
+  const body = data as Record<string, unknown>;
+  const to = body.to;
+  if (typeof body.email_id !== "string" || body.email_id.length < 1
+    || body.email_id.length > 255 || /[\x00-\x1f\x7f]/.test(body.email_id)
+    || !Array.isArray(to) || to.length !== 1
+    || typeof to[0] !== "string" || to[0].length > 320
+    || !/^[!-~]+@[A-Za-z0-9.-]+$/.test(to[0])) {
+    throw new InvalidResendWebhook("Provider recipient association is ambiguous");
+  }
+  if (typeof obj.created_at !== "string") {
+    throw new InvalidResendWebhook("Missing event creation timestamp");
+  }
+  const eventDate = new Date(obj.created_at);
+  if (Number.isNaN(eventDate.getTime()) || eventDate.getTime() > now.getTime() + 300_000
+    || eventDate.getTime() < Date.UTC(2020, 0, 1)) {
+    throw new InvalidResendWebhook("Invalid event creation timestamp");
+  }
+
+  let suppressionReason: VerifiedResendDeliveryEvent["suppressionReason"] = null;
+  if (type === "email.complained") suppressionReason = "spam_complaint";
+  if (type === "email.bounced") {
+    const bounce = body.bounce;
+    if (!bounce || typeof bounce !== "object" || Array.isArray(bounce)
+      || typeof (bounce as Record<string, unknown>).type !== "string") {
+      throw new InvalidResendWebhook("Ambiguous provider bounce classification");
+    }
+    const bounceType = (bounce as Record<string, unknown>).type;
+    if (bounceType === "Permanent") suppressionReason = "permanent_bounce";
+    else if (bounceType !== "Transient") {
+      throw new InvalidResendWebhook("Unsupported provider bounce classification");
+    }
+  }
+  if (type === "email.suppressed") {
+    const suppressed = body.suppressed;
+    if (!suppressed || typeof suppressed !== "object" || Array.isArray(suppressed)) {
+      throw new InvalidResendWebhook("Provider suppression classification missing");
+    }
+  }
+  const hash = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(rawBody));
+  const payloadSha256 = Array.from(new Uint8Array(hash), (b) => b.toString(16).padStart(2, "0")).join("");
+  return {
+    eventId,
+    providerEmailId: body.email_id,
+    recipientEmail: to[0],
+    eventType: type,
+    eventAt: eventDate.toISOString(),
+    payloadSha256,
+    suppressionReason,
+  };
+}
