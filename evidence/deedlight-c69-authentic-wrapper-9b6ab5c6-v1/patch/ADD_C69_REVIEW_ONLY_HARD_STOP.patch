diff --git a/security/review-only/deedlight-c69/PROPOSED_post029_c69_authentic_webhook_transport_hard_stop.sql b/security/review-only/deedlight-c69/PROPOSED_post029_c69_authentic_webhook_transport_hard_stop.sql
